APP_NAME="Evidence energií"
APP_ENV=production
APP_URL=https://energie.example.cz
# U WEDOSu nastavte přesnou adresu databázového serveru ze zákaznické administrace.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=energie
DB_USER=energie
DB_PASSWORD=change_me
GITHUB_REPOSITORY=YOUR_GITHUB_USER/evidence-energii
# Jednorázový webový instalátor: náhodný 64znakový hex token. Po instalaci vymazat.
INSTALL_TOKEN=
# Klíč pro Google Gemini API (Google AI Studio). Pokud je prázdný, odečet lze zadat ručně.
GEMINI_API_KEY=
# Model vhodný pro rychlé rozpoznávání hodnot z fotografie.
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
