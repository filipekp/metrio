APP_NAME="Evidence energií"
APP_ENV=production
APP_URL=https://energie.example.cz
# U WEDOSu nastavte přesnou adresu databázového serveru ze zákaznické administrace.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=energie
DB_USER=energie
DB_PASSWORD=change_me
GITHUB_REPOSITORY=YOUR_GITHUB_USER/evidence-energii
# Jednorázový webový instalátor: náhodný 64znakový hex token. Po instalaci vymazat.
INSTALL_TOKEN=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
