+                                        </small>
+                                    <?php endif; ?>
+                                </td>
+                            <?php endforeach; ?>
+                        </tr>
+                    <?php endforeach; ?>
+                </tbody>
+            </table>
+        </div>
+
+        <p class="muted">
+            HL = hlavní měřidlo, POD = podružné měřidlo.
+            Výpočet přes výměnu zařízení vyžaduje úplné předávací stavy.
+            Odhadované intervaly jsou výslovně označeny.
+        </p>
+    </section>
+<?php endif; ?>
