diff --git a/src/Modules/Consumption/reading_overview.php b/src/Modules/Consumption/reading_overview.php
new file mode 100644
--- /dev/null
+++ b/src/Modules/Consumption/reading_overview.php
@@ -0,0 +1,139 @@
+<?php
+declare(strict_types=1);
+
+// Nejdříve uplatníme stejná přístupová práva jako na stránce Odečty.
+$scopedMeters = meter_scope($u);
+$scopedUnits = unit_scope($u);
+$buildingOptions = [];
+$availableEnergies = [];
+$unitOptions = [];
+
+foreach ($scopedMeters as $meter) {
+    $buildingOptions[(int) $meter['building_id']] = (string) $meter['building_name'];
+}
+
+$selectedBuilding = (int) ($_GET['building_id'] ?? (array_key_first($buildingOptions) ?? 0));
+$selectedUnit = (int) ($_GET['unit_id'] ?? 0);
+$from = (string) ($_GET['from'] ?? date('Y-m-d', strtotime('-90 days')));
+$to = (string) ($_GET['to'] ?? date('Y-m-d'));
+$energy = (string) ($_GET['energy'] ?? '');
+$error = null;
+$overview = ['meters' => [], 'rows' => []];
+$selectedMeters = [];
+
+try {
+    valid_day($from);
+    valid_day($to);
+
+    if ($from > $to) {
+        throw new RuntimeException('Počátek období nesmí být později než konec.');
+    }
+    if ($selectedBuilding !== 0 && !isset($buildingOptions[$selectedBuilding])) {
+        throw new RuntimeException('K vybranému objektu nemáte přístup.');
+    }
+
+    foreach ($scopedUnits as $unit) {
+        if ((int) $unit['building_id'] === $selectedBuilding) {
+            $unitOptions[(int) $unit['id']] = (string) $unit['name'];
+        }
+    }
+    if ($selectedUnit !== 0 && !isset($unitOptions[$selectedUnit])) {
+        throw new RuntimeException('K vybrané jednotce nemáte přístup.');
+    }
+
+    foreach ($scopedMeters as $meter) {
+        if ((int) $meter['building_id'] !== $selectedBuilding) {
+            continue;
+        }
+        if ($selectedUnit !== 0 && (int) ($meter['unit_id'] ?? 0) !== $selectedUnit) {
+            continue;
+        }
+
+        $type = (string) $meter['type'];
+        $availableEnergies[$type] = $labels[$type] ?? $type;
+    }
+
+    if ($energy === '') {
+        $energy = isset($availableEnergies['electricity'])
+            ? 'electricity'
+            : (string) (array_key_first($availableEnergies) ?? '');
+    }
+    if ($energy !== '' && !isset($availableEnergies[$energy])) {
+        throw new RuntimeException('Pro vybraný rozsah není tato energie dostupná.');
+    }
+
+    foreach ($scopedMeters as $meter) {
+        if ((int) $meter['building_id'] !== $selectedBuilding) {
+            continue;
+        }
+        if ($selectedUnit !== 0 && (int) ($meter['unit_id'] ?? 0) !== $selectedUnit) {
+            continue;
+        }
+        if ($meter['type'] === $energy) {
+            $selectedMeters[] = $meter;
+        }
+    }
+
+    if ($selectedMeters) {
+        $ids = array_map(static function (array $meter): int {
+            return (int) $meter['id'];
+        }, $selectedMeters);
+        $placeholders = implode(',', array_fill(0, count($ids), '?'));
+
+        // Kromě intervalu načteme poslední odečet před jeho začátkem pro každé
+        // fyzické zařízení. První zobrazený přírůstek tak má skutečnou základnu.
+        $readings = all(
+            'SELECT r.meter_id, r.device_id, r.reading_date, r.value, r.value_low, d.serial
+             FROM meter_readings r
+             JOIN meter_devices d ON d.id = r.device_id
+             WHERE r.meter_id IN (' . $placeholders . ')
+               AND (
+                   r.reading_date BETWEEN ? AND ?
+                   OR r.reading_date = (
+                       SELECT MAX(p.reading_date)
+                       FROM meter_readings p
+                       WHERE p.device_id = r.device_id AND p.reading_date < ?
+                   )
+               )
+             ORDER BY r.reading_date, r.id',
+            array_merge($ids, [$from, $to, $from])
+        );
+
+        $devices = all(
+            'SELECT * FROM meter_devices WHERE meter_id IN (' . $placeholders . ')
+             ORDER BY meter_id, installed_on, id',
+            $ids
+        );
+        $coefficients = all(
+            'SELECT meter_id, effective_from, coefficient
+             FROM meter_coefficients WHERE meter_id IN (' . $placeholders . ')
+             ORDER BY meter_id, effective_from',
+            $ids
+        );
+
+        $overview = Energy\ReadingOverview::build(
+            $selectedMeters,
+            $readings,
+            $devices,
+            $coefficients,
+            $from,
+            $to
+        );
+    }
+} catch (Throwable $exception) {
+    $error = $exception->getMessage();
+}
+
+return compact(
+    'buildingOptions',
+    'unitOptions',
+    'availableEnergies',
+    'selectedBuilding',
+    'selectedUnit',
+    'selectedMeters',
+    'from',
+    'to',
+    'energy',
+    'overview',
+    'error'
+);
diff --git a/src/ReadingOverview.php b/src/ReadingOverview.php
new file mode 100644
--- /dev/null
+++ b/src/ReadingOverview.php
@@ -0,0 +1,145 @@
+<?php
+declare(strict_types=1);
+
+namespace Energy;
+
+/**
+ * Tabulkový přehled skutečných dnů odečtů.
+ *
+ * Spotřeba náleží intervalu mezi dvěma po sobě jdoucími odečty stejného
+ * logického měřicího místa; nevydává se za spotřebu jednoho kalendářního dne.
+ * Výměny fyzických zařízení řeší Consumption::deviceUsage().
+ */
+final class ReadingOverview
+{
+    /**
+     * @param array $meters Povolená a vyfiltrovaná měřidla
+     * @param array $readings Odečty včetně posledních odečtů před obdobím
+     * @param array $devices Fyzická zařízení vybraných měřidel
+     * @param array $coefficients Historie koeficientů vybraných měřidel
+     */
+    public static function build(
+        array $meters,
+        array $readings,
+        array $devices,
+        array $coefficients,
+        string $from,
+        string $to
+    ): array {
+        $meterIndex = [];
+        foreach ($meters as $meter) {
+            $meterIndex[(int) $meter['id']] = $meter;
+        }
+
+        $devicesByMeter = [];
+        foreach ($devices as $device) {
+            $devicesByMeter[(int) $device['meter_id']][] = $device;
+        }
+
+        $coefficientsByMeter = [];
+        foreach ($coefficients as $coefficient) {
+            $coefficientsByMeter[(int) $coefficient['meter_id']][] = $coefficient;
+        }
+        foreach ($coefficientsByMeter as &$history) {
+            usort($history, static function (array $a, array $b): int {
+                return strcmp((string) $a['effective_from'], (string) $b['effective_from']);
+            });
+        }
+        unset($history);
+
+        $series = [];
+        $events = [];
+        foreach ($readings as $reading) {
+            $meterId = (int) $reading['meter_id'];
+            if (!isset($meterIndex[$meterId])) {
+                continue;
+            }
+
+            $deviceId = (int) $reading['device_id'];
+            $date = (string) $reading['reading_date'];
+            $series[$deviceId][] = $reading;
+            $events[$date][$meterId][] = $reading;
+        }
+
+        ksort($events, SORT_STRING);
+        $previousByMeter = [];
+        $rows = [];
+
+        foreach ($events as $date => $readingsByMeter) {
+            foreach ($readingsByMeter as $meterId => $dayReadings) {
+                $previousDate = $previousByMeter[$meterId] ?? null;
+                $previousByMeter[$meterId] = $date;
+
+                if ($date < $from || $date > $to) {
+                    continue;
+                }
+
+                $cell = [
+                    'readings' => $dayReadings,
+                    'previous_date' => $previousDate,
+                    'usage' => null,
+                    'estimated' => false,
+                    'reason' => 'Chybí předchozí odečet.',
+                ];
+
+                if ($previousDate !== null && $previousDate < $date) {
+                    $includeLowTariff = $meterIndex[$meterId]['type'] === 'electricity';
+                    $usage = Consumption::deviceUsage(
+                        $devicesByMeter[$meterId] ?? [],
+                        $series,
+                        $previousDate,
+                        $date,
+                        $includeLowTariff
+                    );
+
+                    $factor = self::coefficientForInterval(
+                        $coefficientsByMeter[$meterId] ?? [],
+                        $previousDate,
+                        $date
+                    );
+
+                    if ($factor === null) {
+                        $cell['reason'] = 'Během intervalu se změnil koeficient.';
+                    } elseif ($usage === null) {
+                        $cell['reason'] = 'Chybí souvislé podklady pro výpočet (např. při výměně nebo u NT).';
+                    } else {
+                        $cell['usage'] = round((float) $usage['value'] * $factor, 4);
+                        $cell['estimated'] = (bool) $usage['estimated'];
+                        $cell['reason'] = '';
+                    }
+                }
+
+                $rows[$date]['date'] = $date;
+                $rows[$date]['cells'][$meterId] = $cell;
+            }
+        }
+
+        krsort($rows, SORT_STRING);
+
+        return [
+            'meters' => array_values($meterIndex),
+            'rows' => array_values($rows),
+        ];
+    }
+
+    /**
+     * Při změně koeficientu uvnitř intervalu neodhadujeme výslednou spotřebu.
+     * Koeficient platný přesně ke koncovému dni se použije až v dalším intervalu.
+     */
+    private static function coefficientForInterval(array $history, string $from, string $to): ?float
+    {
+        $factor = 1.0;
+        foreach ($history as $change) {
+            $date = (string) $change['effective_from'];
+            if ($date <= $from) {
+                $factor = (float) $change['coefficient'];
+            } elseif ($date < $to) {
+                return null;
+            } else {
+                break;
+            }
+        }
+
+        return $factor > 0 ? $factor : null;
+    }
+}
